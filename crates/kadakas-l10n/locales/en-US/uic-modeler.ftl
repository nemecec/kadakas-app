## uic-modeler: modeler.rs

uic-modeler-tool-select = Select
uic-modeler-tool-eraser = Eraser
uic-modeler-tool-line = Line
uic-modeler-tool-rectangle = Rectangle
uic-modeler-tool-circle = Circle
uic-modeler-tool-arc = Arc
uic-modeler-tool-push-pull = Push/Pull
uic-modeler-tool-move = Move
uic-modeler-tool-rotate = Rotate
uic-modeler-tool-scale = Scale
uic-modeler-tool-tape-measure = Tape Measure
uic-modeler-tool-paint-bucket = Paint Bucket
uic-modeler-tool-orbit = Orbit
uic-modeler-tool-pan = Pan
uic-modeler-tool-zoom = Zoom
uic-modeler-tool-zoom-extents = Zoom Extents
uic-modeler-tool-with-key = { $name } ({ $key })
uic-modeler-tool-later = { $name }: { $note }
uic-modeler-coming-later = coming in a later version
uic-modeler-hint-select = Click an object to select it. Shift adds or removes an object. Hold the middle mouse button to orbit.
uic-modeler-hint-orbit = Drag to orbit. Shift pans.
uic-modeler-hint-pan = Drag to pan the view.
uic-modeler-hint-zoom = Drag up or down to zoom. Shift changes the field of view. Ctrl or Cmd draws a zoom window.
uic-modeler-hint-zoom-extents = Shows the whole model.
uic-modeler-measure-dimensions = Dimensions
uic-modeler-measure-fov = Field of view
uic-modeler-dimensions-value = { $x } × { $y } × { $z }
uic-modeler-hint-eraser = Click an edge, or drag over edges, to erase them. Faces that lose an edge are merged or removed.
uic-modeler-hint-line = Click the start, then each next point. Type a length and press Enter. Esc ends the line. A closed loop makes a face.
uic-modeler-hint-rectangle = Click one corner, then the opposite corner. Type width;height and press Enter.
uic-modeler-hint-circle = Click the center, then a point on the circle. Type a radius, or 24s for the number of sides.
uic-modeler-hint-arc = Click the start and the end of the chord, then the bulge. Type a length, a radius (24r) or segments (12s).
uic-modeler-hint-push-pull = Click a face, move along its normal and click again. Type a distance and press Enter. A double click repeats the last distance.
uic-modeler-measure-length = Length
uic-modeler-measure-radius = Radius
uic-modeler-measure-bulge = Bulge
uic-modeler-measure-distance = Distance
uic-modeling-too-small = The shape is too small to draw.
uic-modeling-pick-face = Push/Pull works on a face. Click a face.
uic-modeling-need-start = Click a start point first, or type a value that fits this tool.
uic-modeling-radius-small = The radius is smaller than half the chord.
uic-modeling-select-first = Select what to change first, then click.
uic-modeling-pick-grip = Click one of the grips on the box around the selection.
uic-modeler-hint-move = Click a base point, move, and click again. Type a distance, x;y;z or <x,y,z> and press Enter. Ctrl (Option on a Mac) toggles copy; after a copy type 5x or /5.
uic-modeler-hint-rotate = Click the center, click the start of the angle, then the end. Arrow keys lock the plane. Type an angle and press Enter. Ctrl (Option on a Mac) toggles copy.
uic-modeler-hint-scale = Click a grip on the box around the selection, move, and click again. Ctrl scales about the center, Shift toggles uniform scaling. Type a factor (2), three factors (1;1;2) or a length.
uic-modeler-measure-angle = Angle
uic-modeler-measure-scale = Scale
uic-modeling-angle-needed = Type an angle to finish the rotation.
uic-modeling-height-kept = A { $kind } keeps its height: it comes from its layer.
uic-modeler-hint-paint-bucket = Click a face to paint the side you see. Ctrl paints connected faces with the same material, Shift all faces with the same material, Alt (Cmd on a Mac) loads the material under the pointer. With objects selected, a click paints them.
uic-paint-default = the default material
uic-paint-painted-one = Painted with { $name }.
uic-paint-painted-many = Painted { $count } faces with { $name }.
uic-paint-painted-objects = Painted { $count } objects with { $name }.
uic-paint-painted-some-objects = Painted { $count } objects. { $skipped } keep the material of their style.
uic-paint-sampled = The bucket holds { $name }.
uic-paint-refused-style = Plants, hardscapes, site models and the like keep the material of their style. Change the style in the Kadakas app.
uic-materials-new-name = Material
uic-materials-copy-name = { $name } copy
uic-materials-created = Material { $name } made.
uic-materials-deleted = Material { $name } deleted.
uic-materials-defaults-there = The built-in materials are in the model already.
uic-materials-defaults-added = Added { $count } built-in materials.
uic-materials-purge-none = No unused materials.
uic-materials-purged = Deleted { $count } unused materials.
uic-materials-name-empty = The name of a material cannot be empty.
uic-materials-name-taken = There is a material named { $name } already.
