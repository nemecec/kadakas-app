<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- NS...UsageDescription keys (camera, location, files and the like) go here, and in
       App-Info.plist: macOS asks the program that the person started (this bundle). -->
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- The .kad document type. The files are ZIP containers, so the type conforms to the ZIP archive and other tools can still open them. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>net.kadakas.drawing</string>
      <key>UTTypeDescription</key>
      <string>Kadakas drawing</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>kad</string>
        </array>
        <key>public.mime-type</key>
        <string>application/vnd.kadakas.drawing+zip</string>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Kadakas drawing</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.kadakas.drawing</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
