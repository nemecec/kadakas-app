ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('wall_with_openings.ifc','2026-01-01T00:00:00',(''),(''),'Kadakas tests','hand written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Wall with openings',$,$,$,$,(#10),#20);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#11,$);
#11=IFCAXIS2PLACEMENT3D(#12,$,$);
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#14=IFCDIRECTION((0.,0.,1.));
#15=IFCDIRECTION((1.,0.,0.));
#16=IFCDIRECTION((0.,1.,0.));
#20=IFCUNITASSIGNMENT((#21));
#21=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#30=IFCSITE('0000000000000000000030',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#11);
#32=IFCRELAGGREGATES('0000000000000000000032',$,$,$,#1,(#30));
/* The wall: 4000 x 200 x 2800, from (0,0,0). */
#100=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,4000.,200.);
#101=IFCCARTESIANPOINT((2000.,100.,0.));
#102=IFCAXIS2PLACEMENT3D(#101,$,$);
#103=IFCEXTRUDEDAREASOLID(#100,#102,#14,2800.);
#104=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#103));
#105=IFCPRODUCTDEFINITIONSHAPE($,$,(#104));
#106=IFCWALL('0000000000000000000106',$,'Garden wall',$,$,#31,#105,$,.STANDARD.);
/* A door opening, 1000 x 2100, as wide as the wall is thick, extruded up. */
#200=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1000.,200.);
#201=IFCCARTESIANPOINT((1000.,100.,0.));
#202=IFCAXIS2PLACEMENT3D(#201,$,$);
#203=IFCEXTRUDEDAREASOLID(#200,#202,#14,2100.);
#204=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#203));
#205=IFCPRODUCTDEFINITIONSHAPE($,$,(#204));
#206=IFCOPENINGELEMENT('0000000000000000000206',$,'Door opening',$,$,#31,#205,$,.OPENING.);
#207=IFCRELVOIDSELEMENT('0000000000000000000207',$,$,$,#106,#206);
/* A window opening, 800 x 1200 at 900 above the floor, extruded along Y and 50 longer on each side. */
#300=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,800.,1200.);
#301=IFCCARTESIANPOINT((3000.,-50.,1500.));
#302=IFCAXIS2PLACEMENT3D(#301,#16,#15);
#303=IFCEXTRUDEDAREASOLID(#300,#302,#14,300.);
#304=IFCSHAPEREPRESENTATION(#13,'Body','SweptSolid',(#303));
#305=IFCPRODUCTDEFINITIONSHAPE($,$,(#304));
#306=IFCOPENINGELEMENT('0000000000000000000306',$,'Window opening',$,$,#31,#305,$,.OPENING.);
#307=IFCRELVOIDSELEMENT('0000000000000000000307',$,$,$,#106,#306);
#900=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000900',$,$,$,(#106,#206,#306),#30);
ENDSEC;
END-ISO-10303-21;
