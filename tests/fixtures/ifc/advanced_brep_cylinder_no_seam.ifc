ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('advanced_brep_cylinder_no_seam.ifc','2026-01-01T00:00:00',(''),(''),'Kadakas tests','hand written','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPROJECT('0000000000000000000001',$,'Advanced brep cylinder without a seam',$,$,$,$,(#10),#20);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-5,#11,$);
#11=IFCAXIS2PLACEMENT3D(#12,$,$);
#12=IFCCARTESIANPOINT((0.,0.,0.));
#13=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#10,$,.MODEL_VIEW.,$);
#14=IFCDIRECTION((0.,0.,1.));
#15=IFCDIRECTION((1.,0.,0.));
#16=IFCDIRECTION((0.,0.,-1.));
#17=IFCDIRECTION((0.,1.,0.));
#18=IFCDIRECTION((0.,-1.,0.));
#19=IFCDIRECTION((-1.,0.,0.));
#20=IFCUNITASSIGNMENT((#21));
#21=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#30=IFCSITE('0000000000000000000030',$,'Site',$,$,#31,$,$,.ELEMENT.,$,$,$,$,$);
#31=IFCLOCALPLACEMENT($,#11);
#32=IFCRELAGGREGATES('0000000000000000000032',$,$,$,#1,(#30));
/* A cylinder, radius 100, height 300 as many exporters write it: the side face has two circles as its bounds and no seam edge. */
#100=IFCCARTESIANPOINT((100.,0.,0.));
#101=IFCCARTESIANPOINT((100.,0.,300.));
#102=IFCVERTEXPOINT(#100);
#103=IFCVERTEXPOINT(#101);
#104=IFCCARTESIANPOINT((0.,0.,300.));
#110=IFCAXIS2PLACEMENT3D(#12,#14,#15);
#111=IFCCIRCLE(#110,100.);
#112=IFCAXIS2PLACEMENT3D(#104,#14,#15);
#113=IFCCIRCLE(#112,100.);
#114=IFCVECTOR(#14,300.);
#115=IFCLINE(#100,#114);
#120=IFCEDGECURVE(#102,#102,#111,.T.);
#121=IFCEDGECURVE(#103,#103,#113,.T.);
#122=IFCEDGECURVE(#102,#103,#115,.T.);
#130=IFCORIENTEDEDGE(*,*,#120,.T.);
#131=IFCORIENTEDEDGE(*,*,#120,.F.);
#132=IFCORIENTEDEDGE(*,*,#121,.T.);
#133=IFCORIENTEDEDGE(*,*,#121,.F.);
#134=IFCORIENTEDEDGE(*,*,#122,.T.);
#135=IFCORIENTEDEDGE(*,*,#122,.F.);
/* bottom: normal down, so the circle runs clockwise seen from above */
#140=IFCEDGELOOP((#131));
#141=IFCFACEOUTERBOUND(#140,.T.);
#142=IFCAXIS2PLACEMENT3D(#12,#16,#15);
#143=IFCPLANE(#142);
#144=IFCADVANCEDFACE((#141),#143,.T.);
/* top: normal up */
#150=IFCEDGELOOP((#132));
#151=IFCFACEOUTERBOUND(#150,.T.);
#152=IFCAXIS2PLACEMENT3D(#104,#14,#15);
#153=IFCPLANE(#152);
#154=IFCADVANCEDFACE((#151),#153,.T.);
/* side */
#160=IFCEDGELOOP((#130));
#161=IFCFACEOUTERBOUND(#160,.T.);
#164=IFCEDGELOOP((#133));
#165=IFCFACEBOUND(#164,.T.);
#162=IFCCYLINDRICALSURFACE(#110,100.);
#163=IFCADVANCEDFACE((#161,#165),#162,.T.);
#170=IFCCLOSEDSHELL((#144,#154,#163));
#171=IFCADVANCEDBREP(#170);
#900=IFCSHAPEREPRESENTATION(#13,'Body','AdvancedBrep',(#171));
#901=IFCPRODUCTDEFINITIONSHAPE($,$,(#900));
#902=IFCBUILDINGELEMENTPROXY('0000000000000000000902',$,'Cylinder',$,$,#31,#901,$,$);
#903=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000903',$,$,$,(#902),#30);
ENDSEC;
END-ISO-10303-21;
